{
  "name": "Dmitry Racing redirects",
  "kind": "zone",
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "ref": "redirect_v2_to_hello",
      "description": "Permanently redirect the v2 website to hello, preserving paths and queries.",
      "expression": "(http.host eq \"v2.dmitryracing.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "target_url": {
            "expression": "concat(\"https://hello.dmitryracing.com\", http.request.uri.path)"
          },
          "status_code": 301,
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
